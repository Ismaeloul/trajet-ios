<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>es</string>
    <key>CFBundleDisplayName</key>
    <string>Trajet</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <!-- El disenio es oscuro a proposito: se mira a contraluz en un vestibulo. -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- El servidor vive en la red de casa (192.168.x) y en el tailnet
         (100.64.0.0/10), sirve HTTP plano y no esta expuesto a internet.
         NSAllowsLocalNetworking no cubre el rango de Tailscale, que es CGNAT
         y no RFC1918, asi que hace falta permitir HTTP sin mas. La app no
         pasa por App Review: se instala firmada con IPA Station. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- iOS pide permiso explicito para hablar con la red local desde iOS 14. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Trajet consulta el servidor de tu NAS para enseñarte los próximos pasos de tus trayectos.</string>
</dict>
</plist>
